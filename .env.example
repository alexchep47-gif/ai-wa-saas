# Copy to .env — never commit real secrets

# SQLite prototype only. The current Prisma schema does not yet support Postgres.
DATABASE_URL="file:./dev.db"

# REQUIRED in production: generate with `openssl rand -hex 32`
AUTH_SECRET=""

# REQUIRED to store each organization's Meta access token encrypted at rest.
# Generate with `openssl rand -hex 32`; keep this key in the deployment secret manager.
WHATSAPP_TOKEN_ENCRYPTION_KEY=""

# Meta webhook configuration: App Secret (HMAC signature) and a random verify token.
META_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
META_GRAPH_API_VERSION="v26.0"

# AI provider key, server-side only.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_NAME="NCAM AI"

# Optional seed administrator. Required only when running `npm run db:seed`.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
