# Database (SQLite for local, Postgres in production)
DATABASE_URL="file:./dev.db"

# Auth secret (generate a long random string)
AUTH_SECRET="change-me-to-a-long-random-string-in-production"

# Optional: Gemini key used only by the background worker (never exposed to the dashboard)
# GEMINI_API_KEY=

# WhatsApp Cloud API (official path)
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_BUSINESS_ACCOUNT_ID=

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_NAME="AI WA SaaS"
