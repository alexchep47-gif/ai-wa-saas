# Copy to .env — never commit real secrets

# SQLite local · use Postgres URL in production
DATABASE_URL="file:./dev.db"

# REQUIRED in production: random string ≥ 32 characters
AUTH_SECRET="change-me-to-a-long-random-string-in-production"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_NAME="AI WA SaaS"

# --- Server-only (workers) — never expose to the browser ---
# GEMINI_API_KEY=
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
